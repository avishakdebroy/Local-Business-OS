# ---------------------------------------------------------------------------
# Local Business OS configuration.
# Copy this file to ".env" and edit. Every value below is optional; the
# defaults shown are what the app uses if you delete the line.
# ---------------------------------------------------------------------------

# Where the database, uploads, reports and backups are kept.
LBOS_DATA_DIR=./data

# Shop locale. Reports and business dates use this timezone.
LBOS_TIMEZONE=Asia/Dhaka
LBOS_CURRENCY=BDT

# Web server. 127.0.0.1 keeps the app reachable only from this computer.
LBOS_HOST=127.0.0.1
LBOS_PORT=8000

# --- Reading receipts -------------------------------------------------------
# OCR turns photos of receipts into text. Requires Tesseract to be installed.
# If Tesseract is missing the app still works; photos just need typing in.
LBOS_OCR_ENABLED=true
LBOS_OCR_LANG=ben+eng
# Only needed if Tesseract is not on PATH, e.g.:
# LBOS_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LBOS_TESSERACT_CMD=

# --- Optional local AI ------------------------------------------------------
# OFF by default: the app reads receipts with built-in rules and needs no AI.
# Turn on only if Ollama is installed and running. It never replaces your
# review - it only proposes values.
LBOS_LLM_ENABLED=false
LBOS_LLM_BASE_URL=http://127.0.0.1:11434
LBOS_LLM_MODEL=qwen2.5:7b-instruct
LBOS_LLM_TIMEOUT_SECONDS=60

# --- Review queue -----------------------------------------------------------
# Entries the app is at least this sure about are recorded automatically.
# Everything else waits for you on the Review screen. 1.0 = review everything.
LBOS_AUTO_POST_THRESHOLD=0.85

# --- Scheduled jobs ---------------------------------------------------------
LBOS_SCHEDULER_ENABLED=true
LBOS_REPORT_DAY=sun
LBOS_REPORT_HOUR=20
LBOS_REPORT_MINUTE=0
LBOS_BACKUP_HOUR=3
LBOS_BACKUP_MINUTE=0
# How many backup files to keep before the oldest is deleted.
LBOS_BACKUP_KEEP=14

# --- Emailing the weekly report (optional) ----------------------------------
LBOS_REPORT_EMAIL_TO=
LBOS_SMTP_HOST=
LBOS_SMTP_PORT=587
LBOS_SMTP_USER=
LBOS_SMTP_PASSWORD=
LBOS_SMTP_FROM=
LBOS_SMTP_USE_TLS=true

# --- Copying backups off this computer (optional) ---------------------------
# Requires rclone. Use an rclone "crypt" remote so the copy is encrypted.
LBOS_RCLONE_REMOTE=
LBOS_RCLONE_PATH=lbos-backups
